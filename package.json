{
  "name": "fenmyr",
  "productName": "Fenmyr",
  "version": "1.0.0",
  "description": "A canvas where ideas thrive, with Myra the cloudberry to help",
  "homepage": "https://github.com/chiangs/fenmyr",
  "license": "MIT",
  "author": "Stephen Chiang",
  "main": "dist/main.cjs",
  "desktopName": "fenmyr.desktop",
  "scripts": {
    "build": "node tools/build.ts",
    "start": "npm run build && electron . --ozone-platform-hint=auto",
    "typecheck": "tsc",
    "lint": "biome check",
    "knip": "knip",
    "budget": "node tools/budget.ts",
    "check:fast": "npm run typecheck && npm run lint && npm run knip && npm run budget && node tools/check-names.ts && node tools/code-map/check.ts && node tools/themes-css.ts --check && node tools/shortcuts-doc.ts --check",
    "test": "npm run build && node tools/run-tests.ts",
    "check": "npm run check:fast && npm test",
    "voice": "node tests/voice.ts",
    "dist": "npm run build && electron-builder --linux AppImage",
    "notices": "node tools/notices.ts",
    "icons": "node tools/icons.ts",
    "perf": "node tests/perf.ts",
    "visual": "node tools/visual-diff.ts",
    "metrics": "node tools/metrics.ts",
    "code-map": "node tools/code-map/build.ts site",
    "dist:mac": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "knip": "^6.44.0",
    "linkedom": "^0.18.15",
    "playwright": "1.63.0",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "io.github.chiangs.fenmyr",
    "productName": "Fenmyr",
    "files": [
      "dist/**",
      "web/**",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "!node_modules/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ],
      "desktop": {
        "entry": {
          "Name": "Fenmyr",
          "Comment": "A canvas where ideas thrive",
          "StartupWMClass": "Fenmyr"
        }
      }
    },
    "appImage": {
      "artifactName": "Fenmyr-${arch}.AppImage"
    },
    "directories": {
      "output": "build/release"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Fenmyr records voice memos on your board.",
        "NSCameraUsageDescription": "Fenmyr can record video cards on your board."
      }
    }
  },
  "dependencies": {
    "@tailwindcss/browser": "^4.3.4",
    "esbuild": "^0.28.2",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "type": "module"
}
