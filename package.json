{
  "name": "myra",
  "productName": "Myra",
  "version": "1.0.0",
  "description": "A canvas where ideas thrive, with Myra the cloudberry to help",
  "homepage": "https://github.com/chiangs/myra",
  "license": "MIT",
  "author": "Stephen Chiang",
  "main": "linux/main.js",
  "desktopName": "myra.desktop",
  "scripts": {
    "start": "electron . --ozone-platform-hint=auto",
    "test": "node tests/vault.js && node tests/smoke.js && node tests/zoom.js && node tests/theme.js && node tests/docs.js",
    "voice": "node tests/voice.js",
    "dist": "electron-builder --linux AppImage",
    "notices": "node tools/notices.js",
    "icons": "node tools/icons.js"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.63.0"
  },
  "build": {
    "appId": "io.github.chiangs.myra",
    "productName": "Myra",
    "files": [
      "linux/**",
      "web/**",
      "assets/icon.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableArgs": [
        "--ozone-platform-hint=auto"
      ],
      "desktop": {
        "entry": {
          "Name": "Myra",
          "Comment": "A canvas where ideas thrive",
          "StartupWMClass": "Myra"
        }
      }
    },
    "appImage": {
      "artifactName": "Myra-${arch}.AppImage"
    },
    "directories": {
      "output": "build/release"
    }
  }
}
