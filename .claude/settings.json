{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(node tests/*)",
      "Bash(node tools/*)",
      "Bash(npx tsc*)",
      "Bash(npx biome *)",
      "Bash(npx knip*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/typecheck.ts\"" }]
      }
    ],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check.ts\"" }] }]
  }
}
