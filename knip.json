{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/host/main.ts",
    "src/host/preload.ts",
    "tests/*.ts",
    "tools/*.ts",
    "tools/code-map/{build,check,query}.ts",
    "tools/code-map/page/main.ts",
    ".claude/hooks/*.ts",
    "src/web/main.ts"
  ],
  "project": ["src/**/*.ts", "tests/**/*.ts", "tools/**/*.ts", "!tools/editor/**", ".claude/hooks/*.ts"],
  "ignoreDependencies": ["@phosphor-icons/core", "@tailwindcss/browser", "react", "react-dom"],
  "ignoreBinaries": ["fc-list", "system_profiler"]
}
