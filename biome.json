{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "*.json",
      ".claude/**",
      "!package-lock.json",
      "src/**",
      "tests/**",
      "tools/**",
      "!tools/editor",
      "!src/host/icon-names.json",
      "!tests/sample-vault",
      "!.claude/settings.local.json",
      "!.claude/scheduled_tasks.lock"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
